# Bounds dev environment variables. Copy to .env.local and edit as needed.
# All keys must be prefixed VITE_ to be exposed to the browser bundle.

# Ollama daemon URL. Defaults to http://localhost:11434 when unset.
# Override if Docker has claimed 11434 on your machine and Ollama runs on
# a different port, or you want to point the Gemma worker at a remote
# Ollama instance you control.
# VITE_OLLAMA_URL=http://127.0.0.1:11435
